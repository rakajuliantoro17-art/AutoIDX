# ==========================================================
# AURA Trade OS
# Git Attributes
# Version : 0.0.1 Alpha
# ==========================================================

# ----------------------------------------------------------
# Default
# ----------------------------------------------------------

* text=auto

# ----------------------------------------------------------
# Force LF (Unix Line Endings)
# ----------------------------------------------------------

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf

*.json text eol=lf

*.css text eol=lf
*.scss text eol=lf

*.html text eol=lf

*.md text eol=lf

*.yml text eol=lf
*.yaml text eol=lf

*.env.example text eol=lf

*.sh text eol=lf

*.py text eol=lf

.gitignore text eol=lf
.gitattributes text eol=lf

# ----------------------------------------------------------
# Binary Assets
# ----------------------------------------------------------

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg binary
*.ico binary

*.pdf binary

*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# ----------------------------------------------------------
# GitHub Linguist
# ----------------------------------------------------------

docs/** linguist-documentation
public/** linguist-generated=false
